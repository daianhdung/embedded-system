# Copy to .env. Restart Python services; rebuild/restart ESP after changes.
# CLI flags > exported environment > .env > local defaults.
PCCC_MQTT_HOST=127.0.0.1
PCCC_MQTT_PORT=1883
PCCC_TOPIC_PREFIX=ptit/nhom07/lab-7c49e2
PCCC_MQTT_USERNAME=""
PCCC_MQTT_PASSWORD=""
# Wokwi uses the Mac gateway hostname, not Python's loopback address.
PCCC_ESP_MQTT_URI=mqtt://host.wokwi.internal:1883
PCCC_MQTT_TLS=0

# local = built-in YOLO plugin; plugin = another installed Python adapter;
# replay = explicitly selected synthetic data. A remote AI worker may publish
# the same MQTT contract; no generic remote HTTP adapter is implemented.
PCCC_AI_BACKEND=local
PCCC_AI_PLUGIN=yolo_plugin:predict
PCCC_AI_SOURCE=0
PCCC_AI_MODEL_PATH=models/fire-smoke-yolov8n.pt
PCCC_AI_MODEL_ID=rabahdev-fire-smoke-yolov8n-13017fe8
PCCC_AI_DEVICE=cpu
# PC acceptance gate; ESP retains its independent 0.8 threshold.
PCCC_AI_CONFIDENCE=0.8
PCCC_EXPECTED_FIRMWARE_ID=""
# Local broker binds only loopback; unauthenticated development use.
PCCC_BROKER_BIND=127.0.0.1
